---
import { ArrowUpRight } from "lucide-astro";

interface Props {
    class?: string;
}

const { class: className } = Astro.props;
const hasLabel = Astro.slots.has("default");
---
<span class="relative inline-flex">
    <a href="mailto:void@wennebro.com" aria-hidden="true" tabindex="-1" class="absolute inset-0 pointer-events-none"></a>
    {hasLabel ? (
        <button type="button" class:list={["c-link cursor-pointer", className]}>
            <slot />
        </button>
    ) : (
        <button type="button" aria-label="Get in touch" class:list={["c-link cursor-pointer text-neutral-500 hover:text-neutral-100 text-sm transition-colors duration-200 inline-flex items-center gap-1.5", className]}>
            <ArrowUpRight size={14} />
            <span class="c-label inline-block bg-current"></span>
        </button>
    )}
</span>

<script>
    import "../lib/email";
</script>
