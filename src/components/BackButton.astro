---
interface Props {
    href: string;
    ariaLabel?: string;
}

const { href, ariaLabel } = Astro.props;

const label = ariaLabel ?? `Back to ${href === "/" ? "home" : href.replace(/^\//, "")}`;
---

<header class="fixed top-0 left-0 z-50 px-6 py-5">
    <a
        href={href}
        aria-label={label}
        class="text-neutral-500 hover:text-neutral-300 text-sm transition-colors duration-200"
    >
        ← Back
    </a>
</header>
