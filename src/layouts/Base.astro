---
import "../styles/global.css";
import { ArrowUpRight } from "lucide-astro";
import { getGravatarHash } from "../lib/gravatar";

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
    ogImageWidth?: number;
    ogImageHeight?: number;
    publishedDate?: string;
    jsonLd?: Record<string, unknown>[];
}

const {
    title,
    description,
    ogImage,
    ogImageWidth,
    ogImageHeight,
    publishedDate,
    jsonLd,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const defaultDescription = "Jacob Wennebro — software engineer.";
const metaDescription = description || defaultDescription;
const siteName = "Jacob Wennebro";
const gravatarHash = await getGravatarHash("jacob@wennebro.com");
const gravatarUrl = `https://gravatar.com/avatar/${gravatarHash}`;

const ogImageExplicit = !!ogImage;
const ogImageURL = ogImageExplicit
    ? ogImage.startsWith("http")
        ? ogImage
        : new URL(ogImage, Astro.site).href
    : gravatarUrl + "?s=512";

const finalOgImageWidth = ogImageWidth ?? (!ogImageExplicit ? 512 : undefined);
const finalOgImageHeight =
    ogImageHeight ?? (!ogImageExplicit ? 512 : undefined);
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link
            rel="preload"
            href="/fonts/inter-400.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/inter-500.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/inter-600.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link rel="icon" type="image/png" href={gravatarUrl + "?s=64"} />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#0a0a0a" />
        <meta name="color-scheme" content="dark" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={metaDescription} />
        <link rel="canonical" href={canonicalURL.href} />

        <!-- JSON-LD -->
        <script
            type="application/ld+json"
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "Person",
                name: "Jacob Wennebro",
                url: "https://www.wennebro.com",
                jobTitle: "Software Engineer II",
                worksFor: {
                    "@type": "Organization",
                    name: "White Label Loyalty",
                    url: "https://whitelabel-loyalty.com",
                },
                address: {
                    "@type": "PostalAddress",
                    addressLocality: "Stockholm",
                    addressCountry: "SE",
                },
                sameAs: [
                    "https://github.com/jacobwennebro",
                    "https://linkedin.com/in/jacobwennebro",
                    "https://instagram.com/jacobwennebro",
                ],
            })}
        />
        {
            jsonLd?.map((obj) => (
                <script
                    type="application/ld+json"
                    set:html={JSON.stringify(obj)}
                />
            ))
        }

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL.href} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:image" content={ogImageURL} />
        {
            finalOgImageWidth && finalOgImageHeight && (
                <>
                    <meta
                        property="og:image:width"
                        content={String(finalOgImageWidth)}
                    />
                    <meta
                        property="og:image:height"
                        content={String(finalOgImageHeight)}
                    />
                </>
            )
        }
        {
            publishedDate && (
                <meta
                    property="article:published_time"
                    content={publishedDate}
                />
            )
        }

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@jacobwennebro" />
        <meta name="twitter:creator" content="@jacobwennebro" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={metaDescription} />
        <meta name="twitter:image" content={ogImageURL} />

        <!-- Author -->
        <meta name="author" content="Jacob Wennebro" />

        <!-- RSS -->
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Jacob Wennebro's Blog"
            href="/rss.xml"
        />

        <slot name="head" />
    </head>
    <body
        class="flex flex-col bg-neutral-950 text-neutral-100 min-h-dvh font-sans antialiased"
    >
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-neutral-800 focus:text-neutral-100 focus:px-4 focus:py-2 focus:rounded focus:text-sm"
        >
            Skip to content
        </a>
        <slot />

        <div
            class="md:fixed md:bottom-0 md:right-0 p-6 md:z-50 text-center md:text-right"
        >
            <a
                href="mailto:jacob@wennebro.com"
                class="text-neutral-500 hover:text-neutral-100 text-sm transition-colors duration-200 inline-flex items-center gap-1.5"
            >
                <ArrowUpRight size={14} />
                jacob@wennebro.com
            </a>
        </div>

        <script>
            import Lenis from "lenis";

            // Image fade-in
            document
                .querySelectorAll<HTMLImageElement>("img[data-fade]")
                .forEach((img) => {
                    if (img.complete) {
                        img.classList.add("loaded");
                    } else {
                        img.addEventListener(
                            "load",
                            () => img.classList.add("loaded"),
                            { once: true },
                        );
                    }
                });

            const prefersReducedMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            const lenis = new Lenis({
                duration: 1.2,
                easing: (t: number) =>
                    Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                smoothWheel: !prefersReducedMotion,
            });

            if (prefersReducedMotion) {
                lenis.destroy();
            }

            (window as any).__lenis = prefersReducedMotion ? null : lenis;

            function raf(time: number) {
                lenis.raf(time);
                requestAnimationFrame(raf);
            }

            if (!prefersReducedMotion) {
                requestAnimationFrame(raf);
            }

            const text = `
                    ⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
        ⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢀⣤⡄⠀⠀⠀⠀⢀⡴⠚⠉⠀⠀⠀⠈⠓⢤⡀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
        ⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⣏⣿⠟⡄⠀⠀⣠⡟⣡⣄⡀⠀⠀⠀⠀⠀⠀⠑⡄⠀⠀⠀⠀⠀⠀⠀⠀⠀
        ⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠉⠙⠛⢾⣦⣴⢋⡞⠋⠙⠻⣦⡀⠀⠀⠀⠀⢀⣼⡀⠀⠀⢠⣾⣿⡀⠀⠀
        ⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢻⡿⢼⣧⣾⣽⡿⣿⣿⡤⣤⣴⣶⣿⠟⠻⠤⣶⡿⠿⠿⠃⠀⠀
        ⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢀⡟⠀⠀⠈⠛⠛⠒⡟⠁⠀⠀⠻⣿⣿⣱⢠⡞⠁⠀⠀⠀⠀⠀⠀
        ⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢸⠃⢠⣶⣤⣤⣾⣇⣶⣀⠀⠀⠀⠀⣍⠁⠀⠘⡄⠀⠀⠀⠀⠀⠀
        ⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⣠⡾⡖⢺⠻⣧⣀⠀⠉⠛⠛⠿⠶⠚⠛⠙⢷⣤⡀⡇⠀⠀⠀⠀⠀⠀
        ⠀⠀⠀⠀⠀⠀⠀⠀⠀⢀⠴⢶⣤⣤⣾⣿⡇⡅⠈⣧⣿⣎⢙⡒⠢⠤⢄⣀⣀⣀⣠⠤⢹⠀⣷⡄⠀⠀⠀⠀⠀
        ⠀⠀⠀⠀⠀⠀⡠⠖⠀⠀⠀⠀⠻⣿⣿⣿⣷⡙⠶⣧⠀⠈⢧⠀⠁⠀⠀⠀⠀⠀⠀⠀⠀⢀⣿⣿⣦⣤⣤⣤⡀
        ⠀⠀⠀⠀⢀⡾⠁⠀⠀⠀⠀⠀⠀⢹⣿⣿⣿⣿⣦⣿⠀⠀⢸⣄⣀⠄⠀⠉⠠⣄⣰⠀⢀⣼⣿⣿⣿⠟⠃⠀⠉
        ⠀⠀⠀⠀⡼⠁⠀⠀⠀⠀⠀⠀⠀⠀⢹⣿⣿⣿⡿⠁⠀⠀⠈⠀⠀⠀⠀⠀⣤⠞⠋⣠⣿⣿⣿⣿⠋⠀⠀⠀⠀
        ⠀⠀⠀⢀⡇⠀⠀⠀⠀⠀⠀⠀⠀⠀⣼⣿⣿⣿⡇⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠘⣿⣿⣿⣿⡇⠀⠀⠀⠀⠀
        ⠀⠀⠀⢸⠀⠀⠀⠀⠀⠀⠀⠀⢀⣴⣿⣿⠟⢋⡅⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢺⣿⣿⣿⣿⠃⠀⠀⠀⠀⠀
        ⠀⠀⠀⡞⠀⠀⠀⠀⡠⠄⣀⠴⠛⠉⠁⠀⠀⢨⠇⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⣽⣿⣾⣿⣷⡄⠀⠀⠀⠀
        ⠀⠀⢸⠁⠀⡠⠂⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢸⡇⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠸⣿⣿⣿⣿⣿⠟⠀⠀⠀⠀
        ⠀⢀⠏⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠠⠄⠈⣇⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⣠⣴⠿⠿⠿⣿⣷⠤⠶⠦⣄⡀
        ⢠⡏⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠘⠄⠂⢹⡀⠀⠀⠀⠀⢀⣀⣠⠾⠟⠋⠉⠀⠀⠀⠀⠀⠀⠀⠀⠀⠉
        ⠸⡇⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢳⣤⡴⠾⠛⠋⢹⡇⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
        ⠀⢻⡄⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠓⠚⢸⣿⣦⡙⢣⠀⠀⠀⢸⡧⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
        ⠀⠈⠛⠒⠒⠒⠒⠒⠒⠒⠒⠒⠒⠒⠒⠒⠒⠛⠛⠛⠛⠓⠒⠒⠒⠚⠛⠒⠒⠂⠐⠂⠀⠀⠀⠀⠀⠀⠀⠀⠀
            `;

            console.log(`%c${text}\n\nWhatcha lookin for .. ?`, "color:lime");
        </script>
    </body>
</html>
