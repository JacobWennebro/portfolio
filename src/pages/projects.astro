---
import Base from "../layouts/Base.astro";

const projects = [
    {
        name: "WordMMO",
        description:
            "An infinitely scaling multiplayer word game. Place tiles, form words, and compete on a shared board that never stops growing. More info to come!",
        tech: ["React", "Golang", "PostgreSQL"],
        status: "In progress",
    },
    {
        name: "SK.TN",
        description:
            "A minimal URL shortener. No JavaScript, anonymous, and 100% free. Supports custom paths, password protected links, vault-based link management, e2e encrypted notes and a simple cURL API.",
        tech: ["Cloudflare Workers", "TypeScript"],
        status: "Live",
        url: "https://sk.tn",
    },
];
---

<Base title="Projects — Jacob Wennebro">
    <header class="fixed top-0 left-0 z-50 px-6 py-5">
        <a
            href="/"
            class="text-neutral-500 hover:text-neutral-300 text-sm transition-colors duration-200"
        >
            ← Back
        </a>
    </header>

    <main class="max-w-3xl mx-auto px-6 py-20 pt-20">
        <h1 class="text-3xl font-semibold tracking-tight mt-8 mb-4">
            Projects
        </h1>
        <p class="text-neutral-400 text-base mb-16">
            Things I'm building / have built.
        </p>

        <ul class="space-y-8">
            {
                projects.map((project) => (
                    <li class="p-6 rounded-lg border border-neutral-800">
                        <div class="flex items-center justify-between mb-2">
                            <h2 class="text-lg font-medium">
                                {project.url ? (
                                    <a
                                        href={project.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="hover:text-blue-400 transition-colors duration-200"
                                    >
                                        {project.name} ↗
                                    </a>
                                ) : (
                                    project.name
                                )}
                            </h2>
                            <span
                                class:list={[
                                    "text-xs rounded-full px-2 py-0.5 border",
                                    project.status === "Live"
                                        ? "text-green-400 border-green-700"
                                        : "text-neutral-500 border-neutral-700",
                                ]}
                            >
                                {project.status}
                            </span>
                        </div>
                        <p class="text-neutral-400 text-sm leading-relaxed mb-3">
                            {project.description}
                        </p>
                        <div class="flex gap-2">
                            {project.tech.map((t) => (
                                <span class="text-[11px] text-neutral-500 bg-neutral-800/50 rounded px-2 py-0.5">
                                    {t}
                                </span>
                            ))}
                        </div>
                    </li>
                ))
            }
        </ul>
    </main>
</Base>
