---
import Base from "../layouts/Base.astro";
import BackButton from "../components/BackButton.astro";
import { ArrowUpRight } from "lucide-astro";

const projects = [
    {
        name: "NixTV",
        description:
            "A private, ad-free Linux operating system for your living-room TV. No telemetry, optional VPN kill switch, and every app and feature toggled from a single config file.",
        tech: ["NixOS", "Nix", "KDE Plasma"],
        status: "In progress",
        url: "https://github.com/JacobWennebro/NixTV",
    },
    {
        name: "SK.TN",
        description:
            "A minimal URL shortener. No JavaScript, anonymous, and 100% free. Supports custom paths, password protected links, vault-based link management, e2e encrypted notes and a simple cURL API.",
        tech: ["Cloudflare Workers", "TypeScript", "D1 SQLite"],
        status: "Live",
        url: "https://sk.tn",
    },
    {
        name: "CraftHog",
        description:
            "Event tracking and analytics for Minecraft servers, powered by PostHog. Capture player activity, world interactions, and command usage with modular event capture, typed filtering, and zero-downtime reloads.",
        tech: ["PostHog", "Kotlin"],
        status: "Live",
        url: "https://github.com/JacobWennebro/crafthog",
    },
];
---

<Base
    title="Projects / Jacob Wennebro"
    description="Projects by Jacob Wennebro — NixTV, SK.TN, and other things I've built."
>
    <BackButton href="/" />

    <main id="main-content" class="grow max-w-3xl mx-auto px-6 py-20 pt-20">
        <h1 class="text-3xl font-semibold tracking-tight mt-8 mb-4">
            Projects
        </h1>
        <p class="text-neutral-400 text-base mb-16">
            Things I'm building / have built.
        </p>

        <ul class="space-y-8">
            {
                projects.map((project) => (
                    <li class="p-6 rounded-lg border border-neutral-800">
                        <div class="flex items-center justify-between mb-2">
                            <h2 class="text-lg font-medium">
                                {project.url ? (
                                    <a
                                        href={project.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="hover:text-blue-400 transition-colors duration-200 inline-flex items-center gap-1"
                                    >
                                        {project.name}{" "}
                                        <ArrowUpRight size={14} />
                                    </a>
                                ) : (
                                    project.name
                                )}
                            </h2>
                            <span
                                class:list={[
                                    "text-xs rounded-full px-2 py-0.5 border",
                                    project.status === "Live"
                                        ? "text-green-400 border-green-700"
                                        : "text-neutral-500 border-neutral-700",
                                ]}
                            >
                                {project.status}
                            </span>
                        </div>
                        <p class="text-neutral-400 text-sm leading-relaxed mb-3">
                            {project.description}
                        </p>
                        <div class="flex gap-2">
                            {project.tech.map((t) => (
                                <span class="text-[11px] text-neutral-500 bg-neutral-800/50 rounded px-2 py-0.5">
                                    {t}
                                </span>
                            ))}
                        </div>
                    </li>
                ))
            }
        </ul>
    </main>
</Base>
