---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
---

<Base
    title="Blog / Jacob Wennebro"
    description="Thoughts on software, self-hosting, travel, and whatever else feels worth writing down."
>
    <header class="fixed top-0 left-0 z-50 px-6 py-5">
        <a
            href="/"
            aria-label="Back to home"
            class="text-neutral-500 hover:text-neutral-300 text-sm transition-colors duration-200"
        >
            ← Back
        </a>
    </header>

    <main
        id="main-content"
        class="grow w-full max-w-3xl mx-auto px-6 py-20 pt-20"
    >
        <h1 class="text-3xl font-semibold tracking-tight mt-8 mb-4">Blog</h1>
        <p class="text-neutral-400 text-base mb-16">
            A place I occasionally dump my thoughts.
        </p>

        <ul class="space-y-10">
            {
                posts.map((post) => (
                    <li>
                        <a href={`/blog/${post.id}`} class="group block">
                            <p class="text-neutral-100 group-hover:text-white transition-colors duration-200">
                                {post.data.title}
                            </p>
                            {post.data.description && (
                                <p class="text-neutral-500 text-sm mt-1">
                                    {post.data.description}
                                </p>
                            )}
                            <p class="text-neutral-600 text-xs mt-2">
                                <time
                                    datetime={new Date(
                                        post.data.date,
                                    ).toISOString()}
                                >
                                    {new Date(
                                        post.data.date,
                                    ).toLocaleDateString("en-US", {
                                        year: "numeric",
                                        month: "long",
                                        day: "numeric",
                                    })}
                                </time>
                            </p>
                        </a>
                    </li>
                ))
            }
        </ul>
    </main>
</Base>
