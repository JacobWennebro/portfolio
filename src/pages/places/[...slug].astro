---
import Base from "../../layouts/Base.astro";
import BackButton from "../../components/BackButton.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

export const getStaticPaths = (async () => {
    const albums = await getCollection("albums");
    return albums.map((album) => ({
        params: { slug: album.id },
        props: { album },
    }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { album } = Astro.props as Props;
const { Content } = await render(album);

function rand(min: number, max: number) {
    return Math.random() * (max - min) + min;
}

const scattered = album.data.images.map((photo) => ({
    ...photo,
    rotate: rand(-5, 5),
    offsetX: rand(-30, 30),
    marginTop: rand(-60, -10),
}));
---

<Base title={`${album.data.name} / Jacob Wennebro`}>
    <BackButton href="/places" />

    <!-- Fixed centered title -->
    <header
        class="fixed top-0 left-0 w-full z-40 flex flex-col items-center justify-center pt-12 pb-6 pointer-events-none"
    >
        <h1 class="text-4xl font-semibold tracking-tight">{album.data.name}</h1>
        <p
            class="text-neutral-400 text-sm mt-2 text-shadow-lg"
        >
            {album.data.country} / <time datetime={album.data.date}
                >{album.data.date}</time
            >
        </p>
    </header>

    <!-- Gradient mask -->
    <div
        class="fixed top-0 left-0 w-full h-32 z-30 pointer-events-none"
        style="background: linear-gradient(to bottom, rgb(10 10 10) 60%, transparent 100%);"
    >
    </div>

    <main id="main-content" class="relative pt-48 pb-24 px-4 max-w-5xl mx-auto">
        <div class="relative">
            {
                scattered.map((photo, i) => (
                    <div
                        class="polaroid relative w-[85vw] md:w-[340px] lg:w-[420px] mx-auto md:ml-[var(--offset)]"
                        style={`--offset: ${photo.offsetX.toFixed(0)}%; transform: rotate(${photo.rotate.toFixed(1)}deg); margin-top: ${i === 0 ? 0 : photo.marginTop.toFixed(0)}px; z-index: ${scattered.length - i};`}
                        tabindex="0"
                        role="button"
                        aria-label={`${photo.caption ?? photo.alt ?? `${album.data.name} photo ${i + 1}`}. Press arrow down to go to next, arrow up for previous, escape to clear.`}
                    >
                        <figure class="bg-white select-none p-3 pb-14 shadow-2xl shadow-black/40">
                            <Image
                                src={photo.src}
                                alt={photo.alt}
                                width={840}
                                quality={80}
                                class="w-full aspect-square object-cover pointer-events-none"
                                loading="lazy"
                                data-fade
                            />
                            {photo.caption && (
                                <figcaption class="absolute bottom-4 left-3 right-3 text-center text-neutral-700 text-xs font-medium tracking-wide truncate">
                                    {photo.caption}
                                </figcaption>
                            )}
                        </figure>
                    </div>
                ))
            }
        </div>

        <!-- Written content below photos -->
        <article
            class="max-w-xl mx-auto mt-32 prose prose-invert prose-neutral prose-sm"
        >
            <Content />
        </article>
    </main>

    <script>
        let keyboardActive = false;

        function updateOpacities() {}

        window.addEventListener("scroll", updateOpacities, { passive: true });
        updateOpacities();

        const polaroids = document.querySelectorAll(
            ".polaroid",
        ) as NodeListOf<HTMLElement>;
        let activeIndex = -1;

        function highlightPolaroid(index: number) {
            keyboardActive = true;
            activeIndex = index;
            const total = polaroids.length;
            polaroids.forEach((el, i) => {
                el.style.transition = "filter 0.3s ease";
                if (i === activeIndex) {
                    el.style.filter = "";
                    el.style.zIndex = String(total + 1);
                } else {
                    el.style.filter = "brightness(0.3)";
                    el.style.zIndex = String(total - i);
                }
            });

            const el = polaroids[activeIndex];
            el.focus();
            const rect = el.getBoundingClientRect();
            const elCenter = rect.top + rect.height / 2;
            const viewCenter = window.innerHeight / 2;
            const scrollTarget = window.scrollY + (elCenter - viewCenter);
            const lenis = (window as any).__lenis;
            if (lenis) {
                lenis.scrollTo(scrollTarget, { duration: 1.2 });
            }
        }

        function clearHighlight() {
            keyboardActive = false;
            activeIndex = -1;
            const total = polaroids.length;
            polaroids.forEach((el, i) => {
                el.style.filter = "";
                el.style.zIndex = String(total - i);
            });
            updateOpacities();
        }

        function findClosestToCenter(): number {
            const viewCenter = window.innerHeight / 2;
            let closest = 0;
            let minDist = Infinity;
            polaroids.forEach((el, i) => {
                const rect = el.getBoundingClientRect();
                const elCenter = rect.top + rect.height / 2;
                const dist = Math.abs(elCenter - viewCenter);
                if (dist < minDist) {
                    minDist = dist;
                    closest = i;
                }
            });
            return closest;
        }

        polaroids.forEach((el, i) => {
            el.addEventListener("keydown", (e) => {
                if (e.key === "ArrowDown") {
                    e.preventDefault();
                    const next =
                        activeIndex < polaroids.length - 1
                            ? activeIndex + 1
                            : activeIndex;
                    if (activeIndex === -1) {
                        highlightPolaroid(findClosestToCenter());
                    } else {
                        highlightPolaroid(next);
                    }
                } else if (e.key === "ArrowUp") {
                    e.preventDefault();
                    if (activeIndex <= 0) {
                        clearHighlight();
                    } else {
                        highlightPolaroid(activeIndex - 1);
                    }
                } else if (e.key === "Escape") {
                    clearHighlight();
                }
            });

            el.addEventListener("blur", () => {
                if (activeIndex === i) {
                    clearHighlight();
                }
            });
        });

        document.addEventListener("mousemove", () => {
            if (activeIndex !== -1) {
                clearHighlight();
            }
        });
    </script>
</Base>
