---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { id: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base
    title={`${post.data.title} — Jacob Wennebro`}
    description={post.data.description}
>
    <main class="max-w-xl mx-auto px-6 py-20">
        <a
            href="/blog"
            class="text-neutral-500 hover:text-neutral-300 text-sm transition-colors duration-200"
        >
            ← Back
        </a>

        <article class="mt-8">
            <header class="mb-12">
                <h1 class="text-3xl font-semibold tracking-tight">
                    {post.data.title}
                </h1>
                <p class="text-neutral-600 text-sm mt-3">
                    {
                        new Date(post.data.date).toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        })
                    }
                </p>
            </header>

            <div class="prose prose-invert prose-neutral prose-sm max-w-none">
                <Content />
            </div>
        </article>
    </main>
</Base>
