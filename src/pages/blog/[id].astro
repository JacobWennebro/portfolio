---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { id: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const words = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(words / 230));
---

<Base
    title={`${post.data.title} — Jacob Wennebro`}
    description={post.data.description}
>
    <header class="fixed top-0 left-0 z-50 px-6 py-5">
        <a
            href="/blog"
            class="text-neutral-500 hover:text-neutral-300 text-sm transition-colors duration-200"
        >
            ← Back
        </a>
    </header>

    <main class="grow max-w-3xl mx-auto px-6 py-20 pt-20">
        <article class="mt-8">
            <header class="mb-12">
                <h1 class="text-3xl font-semibold tracking-tight">
                    {post.data.title}
                </h1>
                <p class="text-neutral-600 text-sm mt-3">
                    {
                        new Date(post.data.date).toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        })
                    }
                    / {readingTime} min read.
                </p>
            </header>

            <div class="prose prose-invert prose-neutral prose-sm max-w-none">
                <Content />
            </div>
        </article>
    </main>
</Base>
