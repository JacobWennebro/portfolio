---
import Base from "../layouts/Base.astro";
import { Github, Linkedin, Instagram } from "lucide-astro";

const email = "jacob@wennebro.com";
const encoder = new TextEncoder();
const data = encoder.encode(email.trim().toLowerCase());
const hashBuffer = await crypto.subtle.digest("SHA-256", data);
const hash = Array.from(new Uint8Array(hashBuffer))
	.map((b) => b.toString(16).padStart(2, "0"))
	.join("");

const res = await fetch(`https://gravatar.com/avatar/${hash}?s=256`);
const buffer = await res.arrayBuffer();
const bytes = new Uint8Array(buffer);
let binary = "";
for (let i = 0; i < bytes.length; i++) {
	binary += String.fromCharCode(bytes[i]);
}
const base64 = btoa(binary);
const contentType = res.headers.get("content-type") ?? "image/jpeg";
const avatarDataUrl = `data:${contentType};base64,${base64}`;
---

<Base
	title="Jacob Wennebro"
	description="Software engineer. Building things, taking photos, and writing about it."
>
	<div class="min-h-screen flex items-center justify-center">
		<main
			class="max-w-md w-full px-6 py-16 flex flex-col items-center text-center gap-8"
		>
			<img
				src={avatarDataUrl}
				alt="Jacob Wennebro — software engineer"
				width={128}
				height={128}
				class="w-32 h-32 rounded-full object-cover"
			/>

			<div class="space-y-3">
				<h1 class="text-2xl font-semibold tracking-tight">
					Jacob Wennebro
				</h1>
				<p class="text-neutral-400 text-base leading-relaxed">
					Software engineer.
				</p>
			</div>

			<nav class="flex items-center gap-6 text-sm">
				<a
					href="/blog"
					class="text-neutral-400 hover:text-neutral-100 transition-colors duration-200"
				>
					Blog
				</a>
				<a
					href="/projects"
					class="text-neutral-400 hover:text-neutral-100 transition-colors duration-200"
				>
					Projects
				</a>
				<a
					href="/places"
					class="text-neutral-400 hover:text-neutral-100 transition-colors duration-200"
				>
					Places
				</a>
			</nav>

			<div class="flex gap-5">
				<a
					href="https://github.com/jacobwennebro"
					target="_blank"
					rel="noopener noreferrer"
					class="text-neutral-500 hover:text-neutral-100 transition-colors duration-200"
					aria-label="GitHub"
				>
					<Github size={20} />
				</a>
				<a
					href="https://linkedin.com/in/jacobwennebro"
					target="_blank"
					rel="noopener noreferrer"
					class="text-neutral-500 hover:text-neutral-100 transition-colors duration-200"
					aria-label="LinkedIn"
				>
					<Linkedin size={20} />
				</a>
				<a
					href="https://instagram.com/jacobwennebro"
					target="_blank"
					rel="noopener noreferrer"
					class="text-neutral-500 hover:text-neutral-100 transition-colors duration-200"
					aria-label="Instagram"
				>
					<Instagram size={20} />
				</a>
			</div>
		</main>
	</div>
</Base>
