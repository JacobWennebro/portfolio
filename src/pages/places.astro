---
import Base from "../layouts/Base.astro";
import PolaroidStack from "../components/PolaroidStack.astro";
import { getCollection } from "astro:content";

const albums = (await getCollection("albums")).sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
---

<Base
    title="Places / Jacob Wennebro"
    description="A personal archive of memorable places I've been — photo albums from my travels."
>
    <!-- Fixed header -->
    <header class="fixed top-0 left-0 z-50 px-6 py-5">
        <a
            href="/"
            class="text-neutral-500 hover:text-neutral-300 text-sm transition-colors duration-200"
        >
            ← Back
        </a>
    </header>

    <main class="grow max-w-3xl mx-auto px-6 py-20 pt-20">
        <h1 class="text-3xl font-semibold tracking-tight mt-8 mb-4">Places</h1>
        <p class="text-neutral-400 text-base mb-16">
            A personal archive of memorable places I've been.
        </p>

        <div
            class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-24 justify-items-center"
        >
            {
                albums.map((album) => (
                    <PolaroidStack
                        images={album.data.images.slice(0, 3).map((p) => p.src)}
                        href={`/places/${album.id}`}
                        name={album.data.name}
                        date={album.data.date}
                        country={album.data.country}
                    />
                ))
            }
        </div>
    </main>
</Base>
