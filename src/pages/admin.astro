---
import countries from "../data/countries.json";

const countrySlugMap: Record<string, string> = {};
for (const c of countries) {
  const slug = c.name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
  countrySlugMap[c.code] = slug;
}
---

<html>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="robots" content="noindex" />
        <link href="/admin/config.yml" type="text/yaml" rel="cms-config-url" />
        <title>Content Manager</title>
    </head>
    <body>
        <script
            is:inline
            src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>
        <script
            is:inline
            define:vars={{ countrySlugMap }}
        >
            CMS.registerEventListener({
                name: "preSave",
                handler: ({ entry }) => {
                    const collection = entry.get("collection");
                    if (collection !== "albums") return;

                    const data = entry.get("data");
                    let newData = data;

                    const countryCode = data.get("country");
                    if (countryCode) {
                        const countrySlug = countrySlugMap[countryCode];
                        if (countrySlug) {
                            newData = newData.set("countrySlug", countrySlug);
                        }
                    }

                    const dateStr = data.get("date");
                    if (dateStr) {
                        const d = new Date(dateStr);
                        const dateSlug = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' })
                            .format(d)
                            .toLowerCase()
                            .replace(/[^a-z0-9]+/g, "-");
                        newData = newData.set("dateSlug", dateSlug);
                    }

                    return newData;
                },
            });
        </script>
    </body>
</html>
